ARG BASE_IMAGE=docker.io/agners/archlinuxarm@sha256:1a4dc79f6ff52711be72889cd0e38182d7e2a6c40b257b0a08cc9b5ef9342f32
FROM ${BASE_IMAGE}

ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG ALL_PROXY
ARG NO_PROXY
ENV HTTP_PROXY=${HTTP_PROXY}
ENV HTTPS_PROXY=${HTTPS_PROXY}
ENV ALL_PROXY=${ALL_PROXY}
ENV NO_PROXY=${NO_PROXY}
ENV http_proxy=${HTTP_PROXY}
ENV https_proxy=${HTTPS_PROXY}
ENV all_proxy=${ALL_PROXY}
ENV no_proxy=${NO_PROXY}

COPY packages.txt /tmp/meowarch-packages.txt
RUN set -eu; packages=""; \
    while IFS= read -r line; do \
      case "$line" in \
        ''|\#*) ;; \
        *) packages="$packages $line" ;; \
      esac; \
    done </tmp/meowarch-packages.txt; \
    pacman -Syu --noconfirm --needed $packages

RUN useradd --create-home --uid 1000 --shell /bin/bash meowarch \
    && printf 'meowarch ALL=(ALL) NOPASSWD: ALL\n' >/etc/sudoers.d/meowarch \
    && chmod 0440 /etc/sudoers.d/meowarch

ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
WORKDIR /workspace
