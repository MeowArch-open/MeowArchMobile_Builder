ARG BASE_IMAGE=docker.io/agners/archlinuxarm@sha256:1a4dc79f6ff52711be72889cd0e38182d7e2a6c40b257b0a08cc9b5ef9342f32
FROM ${BASE_IMAGE}

COPY packages.txt /tmp/meowarch-packages.txt
RUN pacman -Syu --noconfirm --needed $(grep -vE '^[[:space:]]*(#|$)' /tmp/meowarch-packages.txt)

RUN useradd --create-home --uid 1000 --shell /bin/bash meowarch \
    && printf 'meowarch ALL=(ALL) NOPASSWD: ALL\n' >/etc/sudoers.d/meowarch \
    && chmod 0440 /etc/sudoers.d/meowarch

ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
WORKDIR /workspace
