CONFIG_MODULES=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_FB_EFI=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_DRM_MSM=m
CONFIG_DRM_MSM_DPU=y
CONFIG_DRM_MSM_DSI=y
CONFIG_SM_DISPCC_8550=m
CONFIG_DRM_PANEL_XIAOMI_O11_42_02_0A=m
CONFIG_TOUCHSCREEN_FOCALTECH_SPI=m
CONFIG_SND_SOC_SIA91XX=m
CONFIG_BATTERY_QCOM_BATTMGR=y
CONFIG_QCOM_IPA=m
CONFIG_RMNET=m
CONFIG_QRTR=y
CONFIG_QRTR_SMD=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_NAT=y
CONFIG_NF_NAT_MASQUERADE=y
CONFIG_NFT_NAT=y

# Qualcomm WCN7850 Bluetooth over UART serdev
CONFIG_BT=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_HCIUART_QCA=y
CONFIG_BT_QCA=m
CONFIG_SERIAL_DEV_BUS=y
CONFIG_SERIAL_DEV_CTRL_TTYPORT=y
CONFIG_RFKILL=y

# LE + the BREDR protocols BlueZ needs for audio/HID/PAN I/O
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=m
CONFIG_BT_BNEP=m

# WCN7850 BT power path: the serdev child has no enable-gpios on purpose, so
# hci_qca binds pwrseq-qcom-wcn, which owns the seven PMU rails and the
# active-high bt-enable line. Kconfig only defaults this to m under ARCH_QCOM;
# pin it in so a fresh defconfig-based build cannot lose the probe path.
CONFIG_POWER_SEQUENCING=y
CONFIG_POWER_SEQUENCING_QCOM_WCN=y
